---
const year = new Date().getFullYear();
---

<footer>
  <span class="ftr-copy">© {year} Arthur Feeney</span>
  <div class="ftr-links">
    <a href="https://github.com/arthurfeeney" target="_blank" rel="noopener noreferrer">
        github
    </a>
    <a href="https://www.linkedin.com/in/arthur-feeney-af1997/" target="_blank" rel="noopener noreferrer">
        linkedin
    </a>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 1rem;
    border-top: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ftr-copy {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    opacity: 0.4;
    letter-spacing: 0.04em;
  }

  .ftr-links {
    display: flex;
    gap: 1.5rem;
  }

  .ftr-links a {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #555;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ftr-links a:hover { color: #000; }
</style>
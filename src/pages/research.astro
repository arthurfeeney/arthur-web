---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from "astro:content";
import BlogPostLink from '../components/BlogPostLink.astro';
const allPosts = await getCollection("research");
---

<BaseLayout pageTitle="Research">
    <ul>
        {allPosts.map((post: any) => <BlogPostLink 
            linkText={post.data.title}
            postId=`/research_posts/${post.id}` 
            pubDate={post.data.pubDate}/>)
        }
    </ul>
</BaseLayout>

<style>
    ul {
        list-style: none;
        padding: 0px;
        margin: 0;
        gap: 16px;
        display: flex;
        flex-direction: column;
    }
</style>